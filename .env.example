# Copy this file to .env and fill in your own values. Never commit .env.

# Free key from https://console.groq.com/keys
GROQ_API_KEY=
# Optional: override the model (see https://console.groq.com/docs/models)
# LLM_MODEL=openai/gpt-oss-120b

# Phase 1+: Langfuse Cloud free tier (https://cloud.langfuse.com)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
# Phase 2: Wikipedia requires contact info (your email or website) in API requests
WIKI_CONTACT=